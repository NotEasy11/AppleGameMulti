{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applegamemulti",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apple-game-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applegamemulti",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apple-game-db",
      "database_id": "d5fdf473-d365-47ea-bf78-a03d2b1b4ca0"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
